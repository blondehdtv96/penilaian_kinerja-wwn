// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ================================================================
// AUTH & RBAC
// ================================================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  permissions String   @default("[]") // JSON array of permission strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  fullName  String
  nik       String?  @unique @map("nip") // Nomor Induk Karyawan
  isActive  Boolean  @default(true)
  roleId    Int
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  operator  Operator?

  // Relations
  vooSubmissions      VooSubmission[]
  misconducts         Misconduct[]
  counselingsGiven    Counseling[]      @relation("CounselingForeman")
  counselingsAcknowledged Counseling[]  @relation("CounselingAcknowledger")
  kartuKuningIssued     KartuKuning[]         @relation("KartuKuningIssuer")
  suratPeringatanIssued SuratPeringatan[]     @relation("SuratPeringatanIssuer")
  approvals           Approval[]
  eventLogs           EventLog[]
  blockchainHashes    BlockchainHash[]
  qrScans             QrScanLog[]
  notifications       Notification[]
}

// ================================================================
// OPERATOR
// ================================================================

model Operator {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId      String   @unique
  section         String   @default("")
  group           String   @default("") // A, B, C, D, atau Non-Shift
  position        String   @default("Operator")
  photo           String?  // base64 or file path
  qrCode          String   @unique // base64 QR image
  performanceScore Float   @default(0)
  totalMerit      Int      @default(0)
  totalMisconduct Int      @default(0)
  accumulatedPoints Int    @default(0) // == sum(active misconduct points) (R8.1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  vooSubmissions  VooSubmission[]
  misconducts     Misconduct[]
  counselings     Counseling[]
  kartuKunings    KartuKuning[]
  suratPeringatan SuratPeringatan[]
}

// ================================================================
// QR LOCATION AREAS
// ================================================================

model QrLocation {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  area        String
  description String?
  qrImage     String   @unique // base64 QR image
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scanLogs    QrScanLog[]
}

model QrScanLog {
  id           Int        @id @default(autoincrement())
  userId       Int
  user         User       @relation(fields: [userId], references: [id])
  qrLocationId Int
  qrLocation   QrLocation @relation(fields: [qrLocationId], references: [id])
  scannedAt    DateTime   @default(now())
}

// ================================================================
// VOO / IDE KAIZEN SUBMISSION
// ================================================================

model VooSubmission {
  id                Int      @id @default(autoincrement())
  operatorId        Int
  operator          Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  submittedById     Int
  submittedBy       User     @relation(fields: [submittedById], references: [id])
  title             String
  description       String
  type              String   @default("VoO") // VoO or IdeKaizen
  groupShift        String   @default("") // Group/Shift saat pengajuan, mis. "A / 1" atau "- / NS"
  sumberVoo         String   @default("") // Sumber VoO: Laporan Operator, Interview Patrol, LKBK/LKK, Standard Monitoring, Pendapat Baru, Others
  kategori4m        String   @default("") // Kategori 4M: Standard/Process, Mesin, Tools, Material, Lain-Lain
  photos            String   @default("[]") // JSON array of base64 images
  status            String   @default("pending") // pending, approved_foreman, approved_final, rejected
  points            Int      @default(0)
  rejectionReason   String?
  foremanApprovedBy Int?     // userId of foreman
  managerApprovedBy Int?     // userId of section manager
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  approvals         Approval[]
  blockchainHashes  BlockchainHash[]
}

// ================================================================
// VIOLATION TYPE CATALOG
// ================================================================

// Catalog of violation types with configurable point values (R1.1).
model ViolationType {
  id             Int      @id @default(autoincrement())
  name           String
  nameNormalized String   @unique // trim().toLowerCase() for duplicate detection (R1.2)
  category       String
  severity       String
  points         Int      // integer 1..100 (validated in service)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  misconducts    Misconduct[]
}

// ================================================================
// MISCONDUCT
// ================================================================

model Misconduct {
  id              Int      @id @default(autoincrement())
  operatorId      Int
  operator        Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  createdById     Int
  createdBy       User     @relation(fields: [createdById], references: [id])
  type            String   // Late Arrival, Safety Violation, etc.
  severity        String   @default("low") // low, medium, high, critical
  description     String
  evidencePhotos  String   @default("[]") // JSON array
  points          Int      @default(0) // applied snapshot of the violation type's points (R2.1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  blockchainHashes BlockchainHash[]

  // Catalog reference + point snapshot. Nullable so historical rows stay valid (R2.1).
  violationTypeId Int?
  violationType   ViolationType? @relation(fields: [violationTypeId], references: [id])
  isActive        Boolean  @default(true) // active misconducts drive accumulation

  // Counseling tindak lanjut (1 pelanggaran → maksimal 1 sesi konseling).
  counseling      Counseling?

  // Linkage to disciplinary actions that this misconduct contributed to (R5.1, R6.1).
  kartuKuningLinks     KartuKuningMisconduct[]
  suratPeringatanLinks SuratPeringatanMisconduct[]
}

// ================================================================
// COUNSELING
// ================================================================

model Counseling {
  id          Int      @id @default(autoincrement())
  operatorId  Int
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  foremanId   Int
  foreman     User     @relation("CounselingForeman", fields: [foremanId], references: [id])

  // Pelanggaran (Misconduct) yang menjadi dasar sesi konseling ini.
  // Alur: pelanggaran harus diinput lebih dulu, lalu ditindaklanjuti dengan konseling.
  // 1 pelanggaran → maksimal 1 sesi konseling (unique).
  misconductId Int?        @unique
  misconduct   Misconduct? @relation(fields: [misconductId], references: [id], onDelete: Cascade)

  // Lembar COUNSELING - COACHING
  category             String  @default("Others") // Safety | Quality | Produksi | Behaviour | Others
  topic                String                      // Perihal (ringkas)
  pws                  String  @default("")        // Nama pengawas/atasan langsung
  employeeStatement    String  @default("")        // Paparan/Penjelasan dari karyawan (uraian masalah)
  supervisorSuggestion String  @default("")        // Saran dari atasan
  employeeCommitment   String  @default("")        // Komitmen karyawan (mencegah kejadian ulang)
  location             String  @default("")        // Tempat penandatanganan (mis. Bekasi)
  notes                String  @default("")         // catatan tambahan (kompatibilitas data lama)

  // Persetujuan / mengetahui oleh Section Manager
  acknowledgedById Int?
  acknowledgedBy   User?     @relation("CounselingAcknowledger", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ================================================================
// KARTU KUNING (Yellow Card)
// ================================================================

model KartuKuning {
  id          Int      @id @default(autoincrement())
  operatorId  Int
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  issuedById  Int
  issuedBy    User     @relation("KartuKuningIssuer", fields: [issuedById], references: [id])
  reason      String
  accumulatedPointsAtIssuance Int     @default(0)   // snapshot (R5.1)
  escalationLevelAtIssuance   Int     @default(0)   // ordinal used for duplicate check (R5.4)
  isManualOverride            Boolean @default(false) // R5.2
  issuedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  // Contributing active misconducts at issuance (R5.1).
  contributingMisconducts KartuKuningMisconduct[]
}

// ================================================================
// SURAT PERINGATAN (Warning Letter)
// ================================================================

model SuratPeringatan {
  id          Int      @id @default(autoincrement())
  operatorId  Int
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  issuedById  Int
  issuedBy    User     @relation("SuratPeringatanIssuer", fields: [issuedById], references: [id])
  level       Int      // 1, 2, or 3
  reason      String
  accumulatedPointsAtIssuance Int     @default(0)   // snapshot (R6.1)
  isManualOverride            Boolean @default(false) // R6.6
  issuedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  // Contributing active misconducts at issuance (R6.1).
  contributingMisconducts SuratPeringatanMisconduct[]
}

// ================================================================
// DISCIPLINARY LINKAGE (join tables) + ESCALATION CONFIG
// ================================================================

// Join table KartuKuning <-> Misconduct (contributing violations, R5.1).
model KartuKuningMisconduct {
  id            Int         @id @default(autoincrement())
  kartuKuningId Int
  kartuKuning   KartuKuning @relation(fields: [kartuKuningId], references: [id], onDelete: Cascade)
  misconductId  Int
  misconduct    Misconduct  @relation(fields: [misconductId], references: [id], onDelete: Cascade)

  @@unique([kartuKuningId, misconductId])
}

// Join table SuratPeringatan <-> Misconduct (contributing violations, R6.1).
model SuratPeringatanMisconduct {
  id                Int             @id @default(autoincrement())
  suratPeringatanId Int
  suratPeringatan   SuratPeringatan @relation(fields: [suratPeringatanId], references: [id], onDelete: Cascade)
  misconductId      Int
  misconduct        Misconduct      @relation(fields: [misconductId], references: [id], onDelete: Cascade)

  @@unique([suratPeringatanId, misconductId])
}

// Single-row escalation threshold override (R4.6, R4.7).
// Absent by default, so defaults from escalation.ts apply until a Section Manager saves an override.
model EscalationConfig {
  id          Int      @id @default(autoincrement())
  counseling  Int
  kartuKuning Int
  sp1         Int
  sp2         Int
  sp3         Int
  updatedById Int?
  updatedAt   DateTime @updatedAt
}

// ================================================================
// APPROVAL (Append Only)
// ================================================================

model Approval {
  id            Int      @id @default(autoincrement())
  entityType    String   // VooSubmission, Misconduct, etc.
  entityId      Int
  approverId    Int
  approver      User     @relation(fields: [approverId], references: [id])
  action        String   // approve, reject
  notes         String?
  vooSubmissionId Int?
  vooSubmission  VooSubmission? @relation(fields: [vooSubmissionId], references: [id])
  createdAt     DateTime @default(now())
}

// ================================================================
// EVENT LOG (Append Only)
// ================================================================

model EventLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  module    String   // voo, misconduct, auth, etc.
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

// ================================================================
// BLOCKCHAIN HASH
// ================================================================

model BlockchainHash {
  id              Int      @id @default(autoincrement())
  entityType      String   // VooSubmission, Misconduct
  entityId        Int
  txHash          String?  // Ethereum transaction hash
  blockNumber     Int?     // Ethereum block number
  contractAddress String?  // deployed contract address
  data            String   // SHA-256 hash of the data
  vooSubmissionId Int?
  vooSubmission   VooSubmission? @relation(fields: [vooSubmissionId], references: [id])
  misconductId    Int?
  misconduct      Misconduct? @relation(fields: [misconductId], references: [id])
  createdById     Int
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
}

// ================================================================
// NOTIFICATION (inbox per-user, real-time via Socket.IO)
// ================================================================

model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String    @default("info") // info | success | warning | error (severity UI)
  category   String    // voo | misconduct | counseling | kartu_kuning | surat_peringatan
  title      String
  body       String?
  entityType String?   // VooSubmission, Misconduct, dll. (untuk deep-link)
  entityId   Int?
  link       String?   // route frontend yang dibuka saat diklik
  data       String    @default("{}") // payload tambahan (JSON string)
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
